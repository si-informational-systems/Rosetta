<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HostedServiceInstances\KurrentDBProjectionsHostedServiceInstance.fs" />
    <Compile Include="ProjectionStores\ProjectionStores.fs" />
    <Compile Include="EventRepositories\EventRepositories.fs" />
    <Compile Include="ProjectionsExtractor.fs" />
    <Compile Include="HostBuilderExtensions.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SI.Rosetta.Persistence.KurrentDB\SI.Rosetta.Persistence.KurrentDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Persistence.MongoDB\SI.Rosetta.Persistence.MongoDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Persistence.RavenDB\SI.Rosetta.Persistence.RavenDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections.KurrentDB\SI.Rosetta.Projections.KurrentDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections.MongoDB\SI.Rosetta.Projections.MongoDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections.RavenDB\SI.Rosetta.Projections.RavenDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections\SI.Rosetta.Projections.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
  </ItemGroup>

</Project>
