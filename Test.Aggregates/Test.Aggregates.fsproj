<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RavenDB.Client" Version="7.2.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="CommandEndpoint.fs" />
    <Compile Include="QueryEndpoints.fs" />
    <Compile Include="Organization\Organization.fs" />
    <Compile Include="Organization\OrganizationAggregate.fs" />
    <Compile Include="Organization\OrganizationAggregateHandler.fs" />
    <Compile Include="Organization\OrganizationEndpoints.fs" />
    <Compile Include="Person\PersonAggregateState.fs" />
    <Compile Include="Person\PersonAggregate.fs" />
    <Compile Include="Person\PersonAggregateHandler.fs" />
    <Compile Include="Person\PersonEndpoints.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- The test page, served by the app -->
  <ItemGroup>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- config/ is gitignored (local settings and certificates): copy only what exists -->
  <ItemGroup>
    <None Include="config\admin.client.certificate.rentario.pfx" Condition="Exists('config\admin.client.certificate.rentario.pfx')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="config\appsettings.json" Condition="Exists('config\appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SI.Rosetta.Aggregates.HostBuilder\SI.Rosetta.Aggregates.HostBuilder.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.TestKit.ObjectComparer\SI.Rosetta.TestKit.ObjectComparer.fsproj" />
    <ProjectReference Include="..\Test.PL\Test.PL.fsproj" />
  </ItemGroup>

</Project>
