<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Control.TaskSeq" Version="1.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="FSharp.Control.AsyncSeq" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SI.Rosetta.Persistence.KurrentDB\SI.Rosetta.Persistence.KurrentDB.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections\SI.Rosetta.Projections.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Serialization\SI.Rosetta.Serialization.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="KurrentDBProjection.fs" />
    <Compile Include="KurrentDBProjectionParameters.fs" />
    <Compile Include="KurrentDBProjectionBuilder.fs" />
    <Compile Include="CustomProjectionDiscovery.fs" />
    <Compile Include="KurrentDBProjectionsHttpApi.fs" />
    <Compile Include="KurrentDBCustomJSProjectionsFactory.fs" />
    <Compile Include="KurrentDBSubscription.fs" />
    <Compile Include="KurrentDBSubscriptionFactory.fs" />
  </ItemGroup>

</Project>
