<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Databases.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Eventually.fs" />
    <Compile Include="RosettaListener.fs" />
    <Compile Include="RavenDbProjectionsStoreTests.fs" />
    <Compile Include="MongoDbProjectionsStoreTests.fs" />
    <Compile Include="ProjectionsUnitOfWorkTests.fs" />
    <Compile Include="RavenDbClusterWideTests.fs" />
    <Compile Include="MongoConfigTests.fs" />
    <Compile Include="KurrentDBAggregateRepositoryTests.fs" />
    <Compile Include="KurrentDBSnapshotsTests.fs" />
    <Compile Include="StateBasedAggregateRepositoryTests.fs" />
    <Compile Include="OutboxTests.fs" />
    <Compile Include="KurrentDBSubscriptionTests.fs" />
    <Compile Include="KurrentDBCustomProjectionsTests.fs" />
    <Compile Include="HostingTests.fs" />
    <Compile Include="PostgreSqlProjectionsTests.fs" />
    <Compile Include="PostgreSqlAggregatesTests.fs" />
    <Compile Include="OutboxPublisherTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Schema\parcels.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Schema\aggregates.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageReference Include="Testcontainers.KurrentDb" Version="4.16.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.RavenDb" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SI.Rosetta.Aggregates.HostBuilder\SI.Rosetta.Aggregates.HostBuilder.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections.HostBuilder\SI.Rosetta.Projections.HostBuilder.fsproj" />
    <ProjectReference Include="..\SI.Rosetta.Projections.TestKit\SI.Rosetta.Projections.TestKit.fsproj" />
  </ItemGroup>

</Project>
