<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Pluralizer.fs" />
    <Compile Include="UnionCaseInfoUtils.fs" />
    <Compile Include="Messages.fs" />
    <Compile Include="EventType.fs" />
    <Compile Include="EventUpcasting.fs" />
    <Compile Include="OptionFormat.fs" />
    <Compile Include="EventEncoding.fs" />
    <Compile Include="RosettaTelemetry.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="Pluralize.NET" Version="1.0.2" />
  </ItemGroup>

</Project>
